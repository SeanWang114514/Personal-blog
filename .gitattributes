# 统一换行符，避免 Windows 本地与 GitHub Actions (Linux) 构建结果不一致
* text=auto eol=lf

# 明确按二进制处理，防止 Git 改写图片/字体
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.svg text eol=lf

# Shell / Ruby 必须 LF，否则 Linux runner 上会失败
*.sh text eol=lf
Gemfile text eol=lf
Gemfile.lock text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
